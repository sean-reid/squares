{
  "name": "squares-web",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../core --release --target web --out-dir ../web/src/wasm --out-name squares_core -- --features wasm",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "icons": "node scripts/icons.mjs",
    "test:e2e": "playwright test",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.40.0",
    "@types/node": "^24.0.0"
  },
  "packageManager": "pnpm@12.5.1"
}
